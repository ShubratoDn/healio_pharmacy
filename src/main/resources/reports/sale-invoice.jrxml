<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="sale-invoice"
              pageWidth="595"
              pageHeight="842"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20">
    
    <property name="com.jasperreports.print.keep.full.text" value="true"/>
    
    <parameter name="COMPANY_NAME" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["Rupganj Pharmacy"]]></defaultValueExpression>
    </parameter>
    <parameter name="COMPANY_ADDRESS" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["892/1, Beside Shahidbagh Mosque, Rajarbagh, Dhaka - 1217"]]></defaultValueExpression>
    </parameter>
    <parameter name="COMPANY_PHONE" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["01966551343"]]></defaultValueExpression>
    </parameter>
    <parameter name="COMPANY_EMAIL" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>
    
    <parameter name="SALE_NUMBER" class="java.lang.String"/>
    <parameter name="SALE_DATE" class="java.time.LocalDateTime"/>
    <parameter name="CUSTOMER_NAME" class="java.lang.String"/>
    <parameter name="CUSTOMER_PHONE" class="java.lang.String"/>
    <parameter name="CUSTOMER_EMAIL" class="java.lang.String"/>
    <parameter name="CUSTOMER_ADDRESS" class="java.lang.String"/>
    <parameter name="SUBTOTAL" class="java.math.BigDecimal"/>
    <parameter name="DISCOUNT_AMOUNT" class="java.math.BigDecimal"/>
    <parameter name="DISCOUNT_PERCENTAGE" class="java.math.BigDecimal"/>
    <parameter name="TAX_AMOUNT" class="java.math.BigDecimal"/>
    <parameter name="TOTAL_AMOUNT" class="java.math.BigDecimal"/>
    <parameter name="PAID_AMOUNT" class="java.math.BigDecimal"/>
    <parameter name="CHANGE_AMOUNT" class="java.math.BigDecimal"/>
    <parameter name="PAYMENT_METHOD" class="java.lang.String"/>
    <parameter name="PAYMENT_STATUS" class="java.lang.String"/>
    <parameter name="SOLD_BY_NAME" class="java.lang.String"/>
    <parameter name="NOTES" class="java.lang.String"/>
    <parameter name="LOGO_IMAGE" class="java.io.InputStream"/>
    <parameter name="DUE_AMOUNT" class="java.math.BigDecimal"/>
    <parameter name="TOTAL_DISCOUNT_AMOUNT" class="java.math.BigDecimal"/>
    
    <field name="productName" class="java.lang.String"/>
    <field name="quantity" class="java.lang.Integer"/>
    <field name="unitPrice" class="java.math.BigDecimal"/>
    <field name="discountAmount" class="java.math.BigDecimal"/>
    <field name="totalPrice" class="java.math.BigDecimal"/>
    <field name="batchNumber" class="java.lang.String"/>
    <field name="expiryDate" class="java.lang.String"/>
    
    <variable name="itemCount" class="java.lang.Integer" calculation="Count">
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>
    
    <background>
        <band splitType="Stretch"/>
    </background>
    
    <title>
        <band height="60" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="40" backcolor="#0E5A6F"/>
            </rectangle>
            <staticText>
                <reportElement x="0" y="8" width="555" height="24"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="18" isBold="true" fontName="Courier New" pdfFontName="Courier-Bold"/>
                </textElement>
                <text><![CDATA[Sale Invoice]]></text>
            </staticText>
        </band>
    </title>
    
    <pageHeader>
        <band height="170" splitType="Stretch">
            <!-- Logo -->
            <image onErrorType="Blank">
                <reportElement x="0" y="0" width="48" height="48">
                    <printWhenExpression><![CDATA[$P{LOGO_IMAGE} != null]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$P{LOGO_IMAGE}]]></imageExpression>
            </image>
            
            <!-- Company Information -->
            <textField>
                <reportElement x="60" y="0" width="300" height="18"/>
                <textElement>
                    <font size="12" isBold="true" fontName="Courier New" pdfFontName="Courier-Bold"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{COMPANY_NAME}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="60" y="20" width="300" height="14"/>
                <textElement>
                    <font size="10" fontName="Courier New" pdfFontName="Courier"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{COMPANY_ADDRESS}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="60" y="36" width="300" height="14"/>
                <textElement>
                    <font size="10" fontName="Courier New" pdfFontName="Courier"/>
                </textElement>
                <textFieldExpression><![CDATA[($P{COMPANY_EMAIL} != null && !$P{COMPANY_EMAIL}.isEmpty() ? $P{COMPANY_EMAIL} + " | " : "") + $P{COMPANY_PHONE}]]></textFieldExpression>
            </textField>
            
            <!-- Invoice Number and Date Box -->
            <rectangle>
                <reportElement x="350" y="0" width="205" height="45" backcolor="#E7F3F7"/>
            </rectangle>
            <staticText>
                <reportElement x="360" y="8" width="80" height="14"/>
                <textElement>
                    <font size="10" isBold="true" fontName="Courier New" pdfFontName="Courier-Bold"/>
                </textElement>
                <text><![CDATA[Invoice No]]></text>
            </staticText>
            <textField>
                <reportElement x="445" y="8" width="100" height="14"/>
                <textElement>
                    <font size="10" fontName="Courier New" pdfFontName="Courier"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{SALE_NUMBER}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="360" y="24" width="80" height="14"/>
                <textElement>
                    <font size="10" isBold="true" fontName="Courier New" pdfFontName="Courier-Bold"/>
                </textElement>
                <text><![CDATA[Invoice Date]]></text>
            </staticText>
            <textField>
                <reportElement x="445" y="24" width="100" height="14"/>
                <textElement>
                    <font size="10" fontName="Courier New" pdfFontName="Courier"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{SALE_DATE} != null ? 
                    $P{SALE_DATE}.format(java.time.format.DateTimeFormatter.ofPattern("d MMMM yyyy, hh:mm a")) : ""]]></textFieldExpression>
            </textField>
            
            <!-- Payment Information Box -->
            <rectangle>
                <reportElement x="0" y="80" width="260" height="45" backcolor="#E7F3F7"/>
            </rectangle>
            <staticText>
                <reportElement x="10" y="88" width="120" height="14"/>
                <textElement>
                    <font size="10" fontName="Courier New" pdfFontName="Courier"/>
                </textElement>
                <text><![CDATA[Payment Method]]></text>
            </staticText>
            <textField>
                <reportElement x="140" y="88" width="100" height="14"/>
                <textElement>
                    <font size="10" isBold="true" fontName="Courier New" pdfFontName="Courier-Bold"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{PAYMENT_METHOD}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="10" y="105" width="120" height="14"/>
                <textElement>
                    <font size="10" fontName="Courier New" pdfFontName="Courier"/>
                </textElement>
                <text><![CDATA[Payment Status]]></text>
            </staticText>
            <textField>
                <reportElement x="140" y="105" width="100" height="14"/>
                <textElement>
                    <font size="10" isBold="true" fontName="Courier New" pdfFontName="Courier-Bold"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{PAYMENT_STATUS}]]></textFieldExpression>
            </textField>
            
            <!-- Billed To Section -->
            <rectangle>
                <reportElement x="300" y="80" width="255" height="70" backcolor="#F5F7F9"/>
            </rectangle>
            <staticText>
                <reportElement x="310" y="85" width="200" height="14"/>
                <textElement>
                    <font size="10" isBold="true" fontName="Courier New" pdfFontName="Courier-Bold"/>
                </textElement>
                <text><![CDATA[Billed to]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement x="310" y="102" width="230" height="14"/>
                <textElement>
                    <font size="10" fontName="Courier New" pdfFontName="Courier"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{CUSTOMER_NAME} != null ? $P{CUSTOMER_NAME} : "Walk-in Customer"]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="310" y="118" width="230" height="14"/>
                <textElement>
                    <font size="10" fontName="Courier New" pdfFontName="Courier"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{CUSTOMER_ADDRESS}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="310" y="134" width="230" height="14"/>
                <textElement>
                    <font size="10" fontName="Courier New" pdfFontName="Courier"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{CUSTOMER_PHONE}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>
    
    <columnHeader>
        <band height="24" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="24" backcolor="#B7DEE8"/>
            </rectangle>
            <line>
                <reportElement x="0" y="0" width="1" height="24"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#6FAFC3"/>
                </graphicElement>
            </line>
            <line>
                <reportElement x="70" y="0" width="1" height="24"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#6FAFC3"/>
                </graphicElement>
            </line>
            <line>
                <reportElement x="290" y="0" width="1" height="24"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#6FAFC3"/>
                </graphicElement>
            </line>
            <line>
                <reportElement x="370" y="0" width="1" height="24"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#6FAFC3"/>
                </graphicElement>
            </line>
            <line>
                <reportElement x="430" y="0" width="1" height="24"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#6FAFC3"/>
                </graphicElement>
            </line>
            <line>
                <reportElement x="555" y="0" width="1" height="24"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#6FAFC3"/>
                </graphicElement>
            </line>
            <staticText>
                <reportElement x="0" y="5" width="70" height="14"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true" fontName="Courier New" pdfFontName="Courier-Bold"/>
                </textElement>
                <text><![CDATA[#]]></text>
            </staticText>
            <staticText>
                <reportElement x="70" y="5" width="220" height="14"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true" fontName="Courier New" pdfFontName="Courier-Bold"/>
                </textElement>
                <text><![CDATA[Description]]></text>
            </staticText>
            <staticText>
                <reportElement x="290" y="5" width="80" height="14"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true" fontName="Courier New" pdfFontName="Courier-Bold"/>
                </textElement>
                <text><![CDATA[Unit Price]]></text>
            </staticText>
            <staticText>
                <reportElement x="370" y="5" width="60" height="14"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true" fontName="Courier New" pdfFontName="Courier-Bold"/>
                </textElement>
                <text><![CDATA[Qty]]></text>
            </staticText>
            <staticText>
                <reportElement x="430" y="5" width="125" height="14"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true" fontName="Courier New" pdfFontName="Courier-Bold"/>
                </textElement>
                <text><![CDATA[Amount]]></text>
            </staticText>
        </band>
    </columnHeader>
    
    <detail>
        <band height="22" splitType="Stretch">
            <line>
                <reportElement x="0" y="21" width="555" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#6FAFC3"/>
                </graphicElement>
            </line>
            <line>
                <reportElement x="70" y="0" width="1" height="22"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#6FAFC3"/>
                </graphicElement>
            </line>
            <line>
                <reportElement x="290" y="0" width="1" height="22"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#6FAFC3"/>
                </graphicElement>
            </line>
            <line>
                <reportElement x="370" y="0" width="1" height="22"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#6FAFC3"/>
                </graphicElement>
            </line>
            <line>
                <reportElement x="430" y="0" width="1" height="22"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#6FAFC3"/>
                </graphicElement>
            </line>
            <textField>
                <reportElement x="2" y="4" width="66" height="14"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" fontName="Courier New" pdfFontName="Courier"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="72" y="4" width="216" height="14"/>
                <textElement textAlignment="Left" verticalAlignment="Top">
                    <font size="10" fontName="Courier New" pdfFontName="Courier"/>
                    <paragraph leftIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{productName} + ($F{batchNumber} != null && !$F{batchNumber}.isEmpty() ? "\nBatch: " + $F{batchNumber} : "") + ($F{expiryDate} != null && !$F{expiryDate}.isEmpty() ? "\nExpiry: " + $F{expiryDate} : "")]]></textFieldExpression>
            </textField>
            <textField pattern="৳#,##0.00">
                <reportElement x="292" y="4" width="76" height="14"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="10" fontName="Courier New" pdfFontName="Courier"/>
                    <paragraph rightIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{unitPrice}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="372" y="4" width="56" height="14"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" fontName="Courier New" pdfFontName="Courier"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression>
            </textField>
            <textField pattern="৳#,##0.00">
                <reportElement x="432" y="4" width="120" height="14"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="10" fontName="Courier New" pdfFontName="Courier"/>
                    <paragraph rightIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{totalPrice}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    
    <pageFooter>
        <band height="20" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="11" isBold="true" fontName="Courier New" pdfFontName="Courier-Bold"/>
                </textElement>
                <text><![CDATA[Thank you for choosing our pharmacy service!]]></text>
            </staticText>
        </band>
    </pageFooter>
    
    <summary>
        <band height="180" splitType="Stretch">
            <staticText>
                <reportElement x="350" y="0" width="100" height="14"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="10" fontName="Courier New" pdfFontName="Courier"/>
                </textElement>
                <text><![CDATA[Subtotal]]></text>
            </staticText>
            <textField pattern="৳#,##0.00">
                <reportElement x="450" y="0" width="100" height="14"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="10" fontName="Courier New" pdfFontName="Courier"/>
                    <paragraph rightIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{SUBTOTAL}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="350" y="18" width="100" height="14">
                    <printWhenExpression><![CDATA[$P{TAX_AMOUNT} != null && $P{TAX_AMOUNT}.doubleValue() > 0]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="10" fontName="Courier New" pdfFontName="Courier"/>
                </textElement>
                <text><![CDATA[Tax]]></text>
            </staticText>
            <textField pattern="৳#,##0.00" isBlankWhenNull="true">
                <reportElement x="450" y="18" width="100" height="14">
                    <printWhenExpression><![CDATA[$P{TAX_AMOUNT} != null && $P{TAX_AMOUNT}.doubleValue() > 0]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="10" fontName="Courier New" pdfFontName="Courier"/>
                    <paragraph rightIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{TAX_AMOUNT}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="350" y="36" width="100" height="14">
                    <printWhenExpression><![CDATA[$P{TOTAL_DISCOUNT_AMOUNT} != null && $P{TOTAL_DISCOUNT_AMOUNT}.doubleValue() > 0]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="10" fontName="Courier New" pdfFontName="Courier"/>
                </textElement>
                <text><![CDATA[Total Discount]]></text>
            </staticText>
            <textField pattern="৳#,##0.00" isBlankWhenNull="true">
                <reportElement x="450" y="36" width="100" height="14">
                    <printWhenExpression><![CDATA[$P{TOTAL_DISCOUNT_AMOUNT} != null && $P{TOTAL_DISCOUNT_AMOUNT}.doubleValue() > 0]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="10" fontName="Courier New" pdfFontName="Courier"/>
                    <paragraph rightIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{TOTAL_DISCOUNT_AMOUNT}]]></textFieldExpression>
            </textField>
            
            <!-- Due Amount (for Partial Payment) -->
            <staticText>
                <reportElement x="350" y="54" width="100" height="14">
                    <printWhenExpression><![CDATA["PARTIAL".equals($P{PAYMENT_STATUS}) && $P{DUE_AMOUNT} != null && $P{DUE_AMOUNT}.doubleValue() > 0]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="10" isBold="true" fontName="Courier New" pdfFontName="Courier-Bold"/>
                </textElement>
                <text><![CDATA[Due Amount]]></text>
            </staticText>
            <textField pattern="৳#,##0.00" isBlankWhenNull="true">
                <reportElement x="450" y="54" width="100" height="14">
                    <printWhenExpression><![CDATA["PARTIAL".equals($P{PAYMENT_STATUS}) && $P{DUE_AMOUNT} != null && $P{DUE_AMOUNT}.doubleValue() > 0]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="10" isBold="true" fontName="Courier New" pdfFontName="Courier-Bold"/>
                    <paragraph rightIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{DUE_AMOUNT}]]></textFieldExpression>
            </textField>
            
            <!-- Total Box -->
            <rectangle>
                <reportElement x="350" y="72" width="205" height="26" backcolor="#B7DEE8"/>
            </rectangle>
            <staticText>
                <reportElement x="360" y="78" width="80" height="14"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="10" isBold="true" fontName="Courier New" pdfFontName="Courier-Bold"/>
                </textElement>
                <text><![CDATA[Total]]></text>
            </staticText>
            <textField pattern="৳#,##0.00">
                <reportElement x="450" y="78" width="100" height="14"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="10" isBold="true" fontName="Courier New" pdfFontName="Courier-Bold"/>
                    <paragraph rightIndent="2"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{TOTAL_AMOUNT}]]></textFieldExpression>
            </textField>
            
            <!-- Terms and Conditions -->
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="0" y="100" width="340" height="50"/>
                <textElement>
                    <font size="9" fontName="Courier New" pdfFontName="Courier"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{NOTES} != null && !$P{NOTES}.isEmpty() ? $P{NOTES} : 
                    "Payment due 30 days after invoice issuance. All sales are final. Please retain this invoice for your records."]]></textFieldExpression>
            </textField>
        </band>
    </summary>
    
</jasperReport>
